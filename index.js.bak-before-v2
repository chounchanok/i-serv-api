require('dotenv').config({ path: '.env.env' })
const express = require('express');
const session = require('express-session')
const cookieParser = require('cookie-parser');
const rateLimit = require("express-rate-limit");
const fileUpload = require('express-fileupload');
const cors = require('cors');
const path = require('path');

const app = express();

// แอปอยู่หลัง nginx 1 ชั้น: ให้ Express ใช้ IP จริงของผู้ใช้จาก X-Forwarded-For
// (ถ้าไม่มีบรรทัดนี้ rate limit จะนับผู้ใช้ทุกคนเป็น IP เดียวกัน)
app.set('trust proxy', 1);

// ปิดการ caching ของระบบกับ browser กับ server
app.disable('etag');
app.disable('x-powered-by');

app.use(cors());
app.use(express.json({ limit: '50mb' }));
app.use(express.urlencoded({ limit: '50mb', extended: true }));

app.use('/images', express.static(path.join(__dirname, 'images')));
app.use('/images/picture', express.static(path.join(__dirname, 'images/picture')));
app.use('/avatars', express.static(path.join(__dirname, 'avatars')));

app.use(session({
    secret: process.env.SESSION_SECRET || 'keyboard cat',
    resave: false,
    // false = ไม่สร้าง session ในหน่วยความจำให้ทุก request ที่ไม่ได้ใช้ session
    // (ค่า true เดิมทำให้ memory โตขึ้นเรื่อยๆ ตามจำนวน request)
    saveUninitialized: false,
}));
app.use(fileUpload({
    createParentPath: true
}));
app.use(cookieParser());

// health check สำหรับ cron (วางก่อน limiter จึงไม่ถูกนับ rate limit)
app.get('/health', (req, res) => res.send('ok'));

// rate limit รวมทุก request: 300 ครั้งต่อนาทีต่อ IP
const limiter = rateLimit({
    windowMs: 60 * 1000, // 1 minute
    max: 300
});
app.use(limiter);

// login: นับเฉพาะครั้งที่ login ไม่สำเร็จ (กันการเดารหัสผ่าน)
const loginLimiter = rateLimit({
    windowMs: 15 * 60 * 1000, // 15 minutes
    max: 30,
    skipSuccessfulRequests: true,
    message: { message: 'เข้าสู่ระบบไม่สำเร็จหลายครั้งเกินไป กรุณารอ 15 นาทีแล้วลองใหม่' },
});

// ลืมรหัสผ่าน: กันการยิงส่งอีเมลรัวๆ
const forgotLimiter = rateLimit({
    windowMs: 15 * 60 * 1000, // 15 minutes
    max: 10,
    message: { message: 'ขอรีเซ็ตรหัสผ่านบ่อยเกินไป กรุณารอ 15 นาทีแล้วลองใหม่' },
});

app.use('/api/backend/auth/login', loginLimiter);
app.use('/api/backend/send_forgot_email', forgotLimiter);

const backenRouter = require('./routes/backend');

app.get('/', (req, res) => {
    res.send('Hello World!');
});

app.use('/api/backend', backenRouter);

// กันไม่ให้ข้อความใน URL ถูกแทรกเป็น HTML/JavaScript ในหน้า view-images
const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
}[c]));

app.get('/view-images', (req, res) => {
    // ดึงรายชื่อไฟล์จาก URL query string
    const filesQuery = req.query.files;

    if (!filesQuery || typeof filesQuery !== 'string') {
        return res.status(400).send('<h1>ไม่พบข้อมูลรูปภาพ</h1>');
    }

    // แยกชื่อไฟล์ออกจากกันด้วย ','
    const filenames = filesQuery.split(',');

    // URL พื้นฐานที่เก็บรูปภาพ (ต้องตรงกับ imageBaseUrl ในโค้ดสร้าง Excel)
    const imageBaseUrl = 'https://api.iservreport.com/';

    // สร้าง HTML เพื่อแสดงรูปภาพทั้งหมด
    const imagesHtml = filenames.map(filename => {
        const name = escapeHtml(filename.trim());
        return `<img src="${imageBaseUrl}${name}" alt="${name}" style="max-width: 400px; margin: 10px; border: 1px solid #ccc; border-radius: 5px;">`;
    }).join('');

    // สร้างหน้า HTML ทั้งหมด
    const pageHtml = `
        <!DOCTYPE html>
        <html lang="th">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>แกลเลอรีรูปภาพ</title>
            <style>
                body { font-family: sans-serif; text-align: center; }
                h1 { margin-top: 20px; }
                div.gallery { display: flex; flex-wrap: wrap; justify-content: center; padding: 20px; }
            </style>
        </head>
        <body>
            <h1>รูปภาพทั้งหมด</h1>
            <div class="gallery">
                ${imagesHtml}
            </div>
        </body>
        </html>
    `;

    res.send(pageHtml);
});

// error handler (ต้องอยู่หลัง route ทั้งหมด)
app.use(function (err, req, res, next) {
    console.error(new Date().toISOString(), req.method, req.originalUrl);
    console.error(err.stack);
    res.status(err.status || 500).json({
        message: err.message,
        error: err.message,
        stack: process.env.NODE_ENV === 'development' ? err.stack : undefined // ส่ง stack trace เฉพาะโหมด development
    });
});

// บันทึกสาเหตุเมื่อแอปเจอ error ที่ไม่มีใครจับ
process.on('unhandledRejection', (err) => {
    console.error(new Date().toISOString(), 'unhandledRejection:', err);
});
process.on('uncaughtException', (err) => {
    console.error(new Date().toISOString(), 'uncaughtException:', err);
    process.exit(1); // ให้ pm2 restart ใหม่ในสภาพที่สะอาด
});

app.listen(process.env.NODE_PORT || 3003, process.env.NODE_HOST || '0.0.0.0', () => {
    console.log(`Server running at http://${process.env.NODE_HOST}:${process.env.NODE_PORT}/`);
});